{
  "name": "boulette-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Boulette Box — MCP-powered guided communication prototype",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "npm run build && tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  }
}
